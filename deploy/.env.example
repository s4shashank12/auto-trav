# Copy to deploy/.env on the VM and fill in. Never commit the real file.

# --- Compose profiles: local-db runs Postgres here; for HTTPS pick one:
#   https       Caddy on ports 80 and 443 with a Let's Encrypt certificate (recommended)
#   https-port  Caddy on API_PORT only, with its own certificate, when 80/443 are already taken
COMPOSE_PROFILES=local-db,https
# API_PORT=15678                # https-port only; open it in the VM's firewall

# --- API security (required). Generate each with: openssl rand -hex 32
# ADMIN_TOKEN is what you type into the dashboard; APP_SECRET encrypts Travian passwords in the
# database (changing it later makes stored passwords unreadable).
ADMIN_TOKEN=
APP_SECRET=

# --- Dashboard origin(s) allowed to call the API, comma-separated (your Firebase Hosting URLs).
CORS_ORIGINS=https://auto-travian.web.app,https://auto-travian.firebaseapp.com

# --- The name Caddy serves the API on, pointing at this VM. No domain? Use the VM's external IP
# with dashes: 34-12-56-78.sslip.io. The dashboard connects to https://API_DOMAIN
# (or https://API_DOMAIN:API_PORT with the https-port profile).
API_DOMAIN=api.example.com

# --- Database. With the local-db profile, set a password here and leave DATABASE_URL unset.
POSTGRES_DB=travian
POSTGRES_USER=travian
POSTGRES_PASSWORD=
# To use another Postgres instead (Cloud SQL, Supabase, Neon, ...), drop local-db from
# COMPOSE_PROFILES and set the connection here. Connection strings with ?sslmode=require work as
# the provider gives them.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
#
# Encryption, if not already in DATABASE_URL (this setting wins over the URL):
#   require      encrypted, the server's certificate is not checked
#   verify-ca    encrypted, the certificate must be signed by DATABASE_SSL_CA (right for Cloud SQL by IP)
#   verify-full  as verify-ca, and issued for the host name in DATABASE_URL
#   false        no encryption
# DATABASE_SSL=require
# Certificate files go in deploy/certs, which the backend sees as /certs (see certs/README.md).
# Setting a CA turns on verify-ca. Client certificates only if the database requires them.
# DATABASE_SSL_CA=/certs/server-ca.pem
# DATABASE_SSL_CERT=/certs/client-cert.pem
# DATABASE_SSL_KEY=/certs/client-key.pem

# --- Image and updates.
# IMAGE=ghcr.io/s4shashank12/auto-trav:latest
# WATCHTOWER_POLL_INTERVAL=300
# While the GHCR package is private, Watchtower needs a token with read:packages:
# GHCR_USER=your-github-username
# GHCR_TOKEN=ghp_...

# --- Optional.
# BACKEND_BIND=127.0.0.1        # 0.0.0.0 to reach the API on :8080 without Caddy (http only)
# AUTOSTART=true                # start servers that were running when the backend stops
# EVENTS_RETENTION_DAYS=7       # how long bot logs are kept

# --- Memory (defaults fit a 1 GB VM; add swap there, see the README).
# BACKEND_MEM_LIMIT=600m        # a round with Chromium peaks around 450 MB; idle ~60 MB
# DB_MEM_LIMIT=192m
# BROWSER_IDLE_SECONDS=60       # Chromium closes this long after a round; 0 = right away
# DATABASE_POOL_MAX=5
# LOAD_IMAGES=false             # true loads page images too (more memory, nicer screenshots)
# PAGE_TIMEOUT_SECONDS=90       # how long a page load or click may take; raise it if rounds time out
