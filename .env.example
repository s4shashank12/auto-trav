# Copy to .env (never commit it) or set these as environment variables.
# Game world URL, exactly as it appears in the browser address bar after you log in.
TRAVIAN_SERVER=https://ts1.x1.international.travian.com
TRAVIAN_USERNAME=
TRAVIAN_PASSWORD=

# Optional
# HEADLESS=false            # show the browser window
# DRY_RUN=true              # log what would be built without clicking
# BUILD_QUEUE_MAX=3         # jobs per village: 3 for Romans with Travian Plus, 2 without
# RAID_EVERY_MINUTES=10     # --loop: shortest time between raid rounds
# RAID_RADIUS=45            # farm-setup: how far from a village to look for oases
# TRAIN_EVERY_MINUTES=30    # --loop: shortest time between training rounds
# LOOP_MIN_MINUTES=20       # shortest wait between passes in --loop mode
# LOOP_MAX_MINUTES=40       # longest wait between passes in --loop mode
# DEBUG_API=1               # log the game API calls the pages make
