# Copy to .env (never commit it) or set these as environment variables.
# Game world URL, exactly as it appears in the browser address bar after you log in.
TRAVIAN_SERVER=https://ts1.x1.international.travian.com
TRAVIAN_USERNAME=
TRAVIAN_PASSWORD=

# Optional
# HEADLESS=false            # show the browser window
# DRY_RUN=true              # log what would be built without clicking
# BUILD_QUEUE_SLOTS=1       # 2 for Romans (separate field/building queues)
# LOOP_MIN_MINUTES=5        # shortest wait between passes in --loop mode
# LOOP_MAX_MINUTES=45       # longest wait between passes in --loop mode
