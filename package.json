{
  "name": "auto-travian",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright helper that logs into a Travian Legends account and keeps a village's resource fields growing.",
  "type": "module",
  "bin": {
    "auto-travian": "src/cli.js"
  },
  "scripts": {
    "status": "node --env-file-if-exists=.env src/cli.js status",
    "play": "node --env-file-if-exists=.env src/cli.js play",
    "loop": "node --env-file-if-exists=.env src/cli.js play --loop",
    "screenshot": "node --env-file-if-exists=.env src/cli.js screenshot"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "playwright": "1.56.1"
  }
}
